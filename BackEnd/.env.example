# Local development settings only. Never commit real secrets.
APP_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/calendar/google/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/v1/jira/oauth/callback
GOOGLE_WORKSPACE_DOMAIN=example.com
FRONTEND_URL=http://localhost:5173
# Generate with: openssl rand -base64 32
AUTH_COOKIE_SECRET=
BEDROCK_REGION=
BEDROCK_MODEL_ID=
# Gemini API (optional; when configured, Gemini is used for calendar classification)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
# Google Chat App (DM reminders; store service account JSON as base64 in local .env)
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CHAT_APP_AUDIENCE=https://your-public-api.example.com/api/v1/chat/events
DAILY_REMINDER_ENABLED=false
# Optional for local AWS SDK credentials, for example a configured AWS CLI profile.
AWS_PROFILE=
